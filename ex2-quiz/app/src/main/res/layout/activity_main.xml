<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fundo"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <ImageView
            android:layout_width="match_parent"
            android:layout_height="72dp"
            android:layout_marginBottom="16dp"
            android:contentDescription="@string/app_name"
            android:src="@drawable/logo_quiz" />

        <TextView
            android:id="@+id/txtContador"
            style="@style/Rotulo"
            android:layout_marginTop="0dp" />

        <ImageView
            android:id="@+id/imgPlaca"
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="8dp"
            android:contentDescription="@string/app_name"
            android:src="@drawable/placa1" />

        <TextView
            android:id="@+id/txtPergunta"
            style="@style/Rotulo"
            android:layout_width="match_parent" />

        <Button
            android:id="@+id/btnOpcao1"
            style="@style/BotaoOpcao" />

        <Button
            android:id="@+id/btnOpcao2"
            style="@style/BotaoOpcao" />

        <Button
            android:id="@+id/btnOpcao3"
            style="@style/BotaoOpcao" />

        <Button
            android:id="@+id/btnOpcao4"
            style="@style/BotaoOpcao" />

        <Button
            android:id="@+id/btnProxima"
            style="@style/BotaoSecundario"
            android:text="@string/botao_proxima" />

    </LinearLayout>
</ScrollView>
