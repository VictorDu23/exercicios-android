<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="AppTheme" parent="Theme.AppCompat.Light.DarkActionBar">
        <item name="colorPrimary">@color/primaria</item>
        <item name="colorPrimaryDark">@color/primaria_escura</item>
        <item name="colorAccent">@color/primaria</item>
    </style>

    <style name="Rotulo">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">12dp</item>
        <item name="android:textColor">@color/rotulo</item>
        <item name="android:textSize">14sp</item>
    </style>

    <style name="BotaoOpcao">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">8dp</item>
        <item name="android:background">@color/primaria</item>
        <item name="android:textColor">#FFFFFF</item>
    </style>

    <style name="BotaoSecundario">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">20dp</item>
        <item name="android:background">@color/secundaria</item>
        <item name="android:textColor">#FFFFFF</item>
    </style>

</resources>
