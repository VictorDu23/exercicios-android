<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fundo"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <ImageView
            android:layout_width="match_parent"
            android:layout_height="72dp"
            android:layout_marginBottom="16dp"
            android:contentDescription="@string/app_name"
            android:src="@drawable/banner_pizza" />

        <TextView
            style="@style/Rotulo"
            android:layout_width="match_parent"
            android:layout_marginTop="0dp"
            android:text="@string/horario" />

        <TextView
            style="@style/Rotulo"
            android:text="@string/chamada" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <LinearLayout style="@style/Sabor">

                <ImageView
                    android:layout_width="110dp"
                    android:layout_height="110dp"
                    android:contentDescription="@string/sabor_lombinho"
                    android:src="@drawable/pizza_lombinho" />

                <TextView
                    style="@style/Rotulo"
                    android:layout_marginTop="4dp"
                    android:text="@string/sabor_lombinho" />

                <EditText
                    android:id="@+id/editQtdLombinho"
                    style="@style/Campo"
                    android:inputType="number"
                    android:text="@string/zero" />
            </LinearLayout>

            <LinearLayout style="@style/Sabor">

                <ImageView
                    android:layout_width="110dp"
                    android:layout_height="110dp"
                    android:contentDescription="@string/sabor_marguerita"
                    android:src="@drawable/pizza_marguerita" />

                <TextView
                    style="@style/Rotulo"
                    android:layout_marginTop="4dp"
                    android:text="@string/sabor_marguerita" />

                <EditText
                    android:id="@+id/editQtdMarguerita"
                    style="@style/Campo"
                    android:inputType="number"
                    android:text="@string/zero" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">

            <LinearLayout style="@style/Sabor">

                <ImageView
                    android:layout_width="110dp"
                    android:layout_height="110dp"
                    android:contentDescription="@string/sabor_calabresa"
                    android:src="@drawable/pizza_calabresa" />

                <TextView
                    style="@style/Rotulo"
                    android:layout_marginTop="4dp"
                    android:text="@string/sabor_calabresa" />

                <EditText
                    android:id="@+id/editQtdCalabresa"
                    style="@style/Campo"
                    android:inputType="number"
                    android:text="@string/zero" />
            </LinearLayout>

            <LinearLayout style="@style/Sabor">

                <ImageView
                    android:layout_width="110dp"
                    android:layout_height="110dp"
                    android:contentDescription="@string/sabor_pepperoni"
                    android:src="@drawable/pizza_pepperoni" />

                <TextView
                    style="@style/Rotulo"
                    android:layout_marginTop="4dp"
                    android:text="@string/sabor_pepperoni" />

                <EditText
                    android:id="@+id/editQtdPepperoni"
                    style="@style/Campo"
                    android:inputType="number"
                    android:text="@string/zero" />
            </LinearLayout>
        </LinearLayout>

        <Button
            android:id="@+id/btnFazerPedido"
            style="@style/BotaoPrincipal"
            android:text="@string/botao_pedido" />

        <TextView
            android:id="@+id/txtTotal"
            style="@style/Resultado" />

    </LinearLayout>
</ScrollView>
